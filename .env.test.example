# Environment for local integration tests (npm run test:integration).
# Copy to .env.test and fill in the TEST Supabase project's values.
# The anon key is public-by-design (RLS protects the data) — but .env.test is
# gitignored regardless. NEVER put the service_role key here.

VITE_SUPABASE_URL="https://<your-test-project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-test-project-anon-key>"
