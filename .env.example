# Copy this file to .env and fill in the values. NEVER commit real values —
# .env is gitignored. (For integration tests, use the local Docker sandbox —
# see docs/local-sandbox.md. .env is NOT used by the integration tests.)

# --- Required to build/run the app (frontend) ---
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-anon-key>"             # public by design (RLS protects data)
VITE_SUPABASE_PUBLISHABLE_KEY="<your-publishable-key>"

# --- Maintainer tooling only (NOT needed just to run the app) ---
# Used by .mcp.json (Supabase MCP servers) and supabase/reset-env.sh:
SUPABASE_PROJECT_ID="<prod-project-ref>"
SUPABASE_TEST_PROJECT_ID="<test-project-ref>"
SUPABASE_PAT="<supabase-personal-access-token>"      # SECRET — account-scoped; keep private
