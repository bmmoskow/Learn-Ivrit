{
  // Type-checks the Playwright test tree (tests/). The app configs
  // (tsconfig.app.json "include": ["src"]) and the build never see these files,
  // and Playwright transpiles specs WITHOUT type-checking — so without this a
  // type error in a spec (e.g. a wrong Locator method) only surfaces at runtime.
  // Run via `npm run typecheck` (which also covers src/).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — matches how Playwright resolves specs */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,

    /* Linting — same strictness as the app/node configs */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["tests"]
}
