# Local Docker Supabase sandbox. Copy to `.env.local` to point the app dev
# server AND the integration tests at your LOCAL stack. See docs/local-sandbox.md.
#
# .env.local is gitignored. The local anon key is a fixed, public development
# key (not a secret). The integration prod-guard treats a localhost URL as safe,
# so these tests can never touch prod.

VITE_SUPABASE_URL="http://127.0.0.1:54321"

# The standard Supabase local anon key (same for every local stack). If auth
# fails, copy the current value from the `supabase status` / `supabase start`
# output instead.
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE"
