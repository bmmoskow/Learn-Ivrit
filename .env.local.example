# Local Docker Supabase sandbox template. Points the app dev server AND the
# integration tests at your LOCAL stack. See docs/local-sandbox.md.
#
# Easiest path: run `npm run sandbox:env` (after `npm run sandbox:start`) — it
# fills .env.local from this template with your stack's real key automatically.
# Or copy this file to .env.local by hand and paste the values yourself.
#
# .env.local is gitignored. The publishable key is a local development key (not
# a secret). The integration prod-guard treats a localhost URL as safe, so these
# tests can never touch prod.

VITE_SUPABASE_URL="http://127.0.0.1:54321"

# Paste the "Publishable" key from `supabase status` (Authentication Keys) for
# YOUR local stack. Recent Supabase CLI (2.95+) gives each stack its own
# asymmetric signing keys, so there is no universal demo anon key — the old
# HS256 demo JWT fails with PGRST301 ("No suitable key or wrong key type").
# Re-copy this whenever you re-init the stack.
VITE_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
